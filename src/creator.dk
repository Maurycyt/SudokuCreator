import SudokuCreator.partial_sudoku.PartialSudoku;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.SudokuSolver;
import SudokuCreator.sudoku_solver.SolveResult;
import SudokuCreator.sudoku_solver.difficulty.*;

# The board being edited, re-analyzed after every change.
class Creator {
	puzzle: PartialSudoku;
	result: SolveResult;          # the strategies' solution of the board
	difficulty: CellDifficulty;
	unsolvable: bool;             # the board provably has no solution
	undetermined: bool;           # some empty cell no known strategy can place

	fun get(c: CellCoord) -> i64 = puzzle.at(c);

	fun set(c: CellCoord, digit: i64) = {
		puzzle.at(c) = digit;
		analyze();
	}

	# See PartialSudoku.parse for the format.
	fun load(board: str) = {
		puzzle = PartialSudoku.parse(board);
		analyze();
	}

	fun analyze() = {
		var solver = SudokuSolver.create(&puzzle);
		result = solver.solve();
		difficulty = CellDifficulty.of(&result);
		# Checked after solving: sound deductions can expose a contradiction the digits alone don't.
		unsolvable = solver.state.has_contradiction();
		undetermined = false;
		for (c in CELLS) {
			if (get(c) == 0 and not difficulty.placeable(c)) { undetermined = true; }
		}
	}
}
