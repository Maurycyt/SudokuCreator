import core.builtins.*;

# Sudoku board and puzzle generator.
# Cells are indexed 0..80 row by row; 0 means empty.

var grid: i64[81];
var given: bool[81];
var rng_state: i64 = 12345;

fun seed_rng(seed: i64) = {
    rng_state = seed % 2147483647 + 1;
}

# Linear congruential generator; good enough for shuffling cells and digits.
fun rand_below(n: i64) -> i64 = {
    rng_state = (rng_state * 1103515245 + 12345) % 2147483648;
    return (rng_state / 65536) % n;
}

fun can_place(idx: i64, v: i64) -> bool = {
    let r = idx / 9;
    let c = idx % 9;
    let br = r / 3 * 3;
    let bc = c / 3 * 3;
    var i: i64 = 0;
    while (i < 9) {
        let in_row = r * 9 + i;
        let in_col = i * 9 + c;
        let in_box = (br + i / 3) * 9 + bc + i % 3;
        if (in_row != idx and grid[in_row] == v) { return false; }
        if (in_col != idx and grid[in_col] == v) { return false; }
        if (in_box != idx and grid[in_box] == v) { return false; }
        i = i + 1;
    }
    return true;
}

fun candidate_count(idx: i64) -> i64 = {
    var count: i64 = 0;
    var v: i64 = 1;
    while (v <= 9) {
        if (can_place(idx, v)) { count = count + 1; }
        v = v + 1;
    }
    return count;
}

# The empty cell with the fewest candidates: 81 when the board is full, -1 when some empty cell
# has no candidate at all (a dead end).
fun best_empty_cell() -> i64 = {
    var best: i64 = 81;
    var best_count: i64 = 10;
    var i: i64 = 0;
    while (i < 81) {
        if (grid[i] == 0) {
            let count = candidate_count(i);
            if (count < best_count) {
                best = i;
                best_count = count;
            }
        }
        i = i + 1;
    }
    if (best_count == 0) { return 0 - 1; }
    return best;
}

# Fills the empty cells with a random valid solution. Returns false when there is none.
fun fill_random() -> bool = {
    let idx = best_empty_cell();
    if (idx == 81) { return true; }
    if (idx < 0) { return false; }

    var order: i64[9];
    var k: i64 = 0;
    while (k < 9) {
        order[k] = k + 1;
        k = k + 1;
    }
    k = 8;
    while (k > 0) {
        let j = rand_below(k + 1);
        let tmp = order[k];
        order[k] = order[j];
        order[j] = tmp;
        k = k - 1;
    }

    k = 0;
    while (k < 9) {
        let v = order[k];
        if (can_place(idx, v)) {
            grid[idx] = v;
            if (fill_random()) { return true; }
            grid[idx] = 0;
        }
        k = k + 1;
    }
    return false;
}

# Counts the solutions of the current board, stopping at `limit`. The board is left unchanged.
fun count_solutions(limit: i64) -> i64 = {
    let idx = best_empty_cell();
    if (idx == 81) { return 1; }
    if (idx < 0) { return 0; }
    var count: i64 = 0;
    var v: i64 = 1;
    while (v <= 9 and count < limit) {
        if (can_place(idx, v)) {
            grid[idx] = v;
            count = count + count_solutions(limit - count);
            grid[idx] = 0;
        }
        v = v + 1;
    }
    return count;
}

# Generates a new puzzle with a unique solution and about `clues` given digits.
fun generate(clues: i64) = {
    var i: i64 = 0;
    while (i < 81) {
        grid[i] = 0;
        i = i + 1;
    }
    let filled = fill_random();

    var order: i64[81];
    i = 0;
    while (i < 81) {
        order[i] = i;
        i = i + 1;
    }
    i = 80;
    while (i > 0) {
        let j = rand_below(i + 1);
        let tmp = order[i];
        order[i] = order[j];
        order[j] = tmp;
        i = i - 1;
    }

    var remaining: i64 = 81;
    i = 0;
    while (i < 81 and remaining > clues) {
        let idx = order[i];
        let saved = grid[idx];
        grid[idx] = 0;
        if (count_solutions(2) == 1) {
            remaining = remaining - 1;
        } else {
            grid[idx] = saved;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 81) {
        given[i] = grid[i] != 0;
        i = i + 1;
    }
}

# A filled cell whose digit repeats in its row, column or box.
fun is_conflict(idx: i64) -> bool = {
    if (grid[idx] == 0) { return false; }
    return not can_place(idx, grid[idx]);
}

fun is_solved() -> bool = {
    var i: i64 = 0;
    while (i < 81) {
        if (grid[i] == 0) { return false; }
        if (is_conflict(i)) { return false; }
        i = i + 1;
    }
    return true;
}

# Sets a digit (0 clears) in a cell that is not part of the puzzle.
fun set_cell(idx: i64, v: i64) = {
    if (not given[idx]) { grid[idx] = v; }
}
