import core.builtins.*;
import core.containers.*;
import core.optional.*;
import src.multiset.*;

fun check(label: str, cond: bool) = {
	print(label);
	print(": ");
	print(cond);
	print('\n');
}

fun main() = {
	var ms: Multiset[i64];
	var values: List[i64];
	values.push(5); values.push(3); values.push(8); values.push(1); values.push(4);
	values.push(7); values.push(9); values.push(2); values.push(6); values.push(3);
	values.push(5); values.push(5);
	var i = 0;
	while (i < values.length()) { ms.add(values.at(i)); i += 1; }

	check("count(3) == 2", ms.count(3) == 2);
	check("count(5) == 3", ms.count(5) == 3);
	check("count(10) == 0", ms.count(10) == 0);

	let mn = ms.min();
	match (mn) { case v: i64 = check("min == 1", v == 1); case _: optional_primitives.None = check("min is none (wrong)", false); };
	let mx = ms.max();
	match (mx) { case v: i64 = check("max == 9", v == 9); case _: optional_primitives.None = check("max is none (wrong)", false); };

	ms.remove(5);
	check("count(5) == 2 after one remove", ms.count(5) == 2);
	ms.remove(5);
	ms.remove(5);
	check("count(5) == 0 after three removes", ms.count(5) == 0);
	let mx2 = ms.max();
	match (mx2) { case v: i64 = check("max == 9 still", v == 9); case _: optional_primitives.None = check("max is none (wrong)", false); };

	ms.remove(9);
	let mx3 = ms.max();
	match (mx3) { case v: i64 = check("max == 8 now", v == 8); case _: optional_primitives.None = check("max is none (wrong)", false); };

	# Remove everything and check emptiness.
	var j = 0;
	while (j < values.length()) { ms.remove(values.at(j)); j += 1; }
	ms.remove(9);
	let mn_empty = ms.min();
	match (mn_empty) { case v: i64 = check("min is none when empty (wrong, got value)", false); case _: optional_primitives.None = check("min is none when empty", true); };

	# Larger stress test to exercise rotations in both directions.
	var ms2: Multiset[i64];
	var k = 0;
	while (k < 200) { ms2.add((k * 37) % 101); k += 1; }
	var all_ok = true;
	k = 0;
	while (k < 101) {
		if (ms2.count(k) < 1) { all_ok = false; }
		k += 1;
	}
	check("stress: all keys 0..100 present", all_ok);
	let mn3 = ms2.min();
	match (mn3) { case v: i64 = check("stress min == 0", v == 0); case _: optional_primitives.None = check("stress min none (wrong)", false); };
	let mx4 = ms2.max();
	match (mx4) { case v: i64 = check("stress max == 100", v == 100); case _: optional_primitives.None = check("stress max none (wrong)", false); };

	return 0i64;
}
