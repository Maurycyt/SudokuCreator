import core.builtins.*;
import core.containers.*;
import core.optional.*;
import SudokuCreator.creator.Creator;
import SudokuCreator.creator.examples.*;
import SudokuCreator.multiset.*;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.SolveResult;
import SudokuCreator.sudoku_solver.all_strategies;
import SudokuCreator.sudoku_solver.difficulty.*;

# Diagnostics without a window, selected by the SUDOKU_HEADLESS environment variable:
#   SUDOKU_HEADLESS=<81-character board>  prints how the strategies solve the board
#                                         (format: see PartialSudoku.parse);
#   SUDOKU_HEADLESS=batch                 reads boards from stdin, one per line, and prints
#                                         "solved|stuck <hardest difficulty> <board>" for each;
#   SUDOKU_HEADLESS=<anything else>       runs the self-tests; exit code 1 on failure.

extern("C") {
	fundecl getenv(name: cptr char) -> cptr u8;
}

fun headless_arg() -> ?String = {
	let p = getenv(builtins.ptr_from_slice[char]("SUDOKU_HEADLESS\0") as cptr char);
	if (p as u64 == 0u64) { return none; }
	var s: String;
	var i = 0;
	while (p[i] != 0u8) {
		s.append(p[i] as char);
		i += 1;
	}
	return s;
}

fun run_headless(arg: ref String) -> i64 = {
	if (arg.length() == 81) {
		explain(arg.asSlice());
		return 0;
	}
	if (arg == "batch".toString()) {
		batch();
		return 0;
	}
	return if self_test() then 0i64 else 1i64;
}

# Stops at the first line that is not a board, e.g. the end of input.
fun batch() = {
	var line = builtin_input_string();
	while (line.length() == 81) {
		var creator: Creator;
		creator.load(line.asSlice());
		let r = &creator.result;
		let status = if r.stuck then "stuck" else "solved";
		print(f"{status} {hardest_strategy(r)} {line}\n");
		line = builtin_input_string();
	}
}

fun explain(board: str) = {
	var creator: Creator;
	creator.load(board);
	print_summary(&creator);
	let r = &creator.result;
	var m = 0;
	var i = 0;
	while (i < r.steps.length()) {
		let step = r.steps.at(i);
		if (m < r.move_start.length() and r.move_start.at(m) == i) {
			m += 1;
			print(f"\nmove {m}: {step.strategy}\n");
		}
		print(f"  {step.text}\n");
		i += 1;
	}
}

fun hardest_strategy(r: ref SolveResult) -> f64 = {
	var hardest: f64 = 0.0;
	var i = 0;
	while (i < r.steps.length()) {
		if (r.steps.at(i).difficulty > hardest) { hardest = r.steps.at(i).difficulty; }
		i += 1;
	}
	return hardest;
}

# The board shows entered digits, '.' for cells the strategies place and '?' for the rest.
fun print_summary(creator: ref Creator) = {
	let r = &creator.result;
	print(f"steps={r.steps.length()} moves={r.move_start.length()} stuck={r.stuck} unsolvable={creator.unsolvable} undetermined={creator.undetermined}\n");
	print(f"hardest strategy={hardest_strategy(r)} remaining difficulty={remaining_difficulty(r, 0)}\n");
	for (c in CELLS) {
		let d = creator.get(c);
		if (d != 0) { print('0' + (d as u8)); }
		else { print(if creator.difficulty.placeable(c) then '.' else '?'); }
		if (c.col == 8) { print('\n'); }
	}
}

fun check(ok: bool, label: str) -> bool = {
	if (not ok) { print(f"FAIL: {label}\n"); }
	return ok;
}

fun check_example(ex: ref ExampleBoard) -> bool = {
	var creator: Creator;
	creator.load(ex.board);
	print(f"== {ex.name} (expected difficulty {ex.max_difficulty}) ==\n");
	print_summary(&creator);
	let solved = check(not creator.result.stuck, "not solved");
	let exact = check(hardest_strategy(&creator.result) == ex.max_difficulty, "the hardest strategy used is not the expected one");
	print('\n');
	return solved and exact;
}

fun uses(r: ref SolveResult, strategy: str) -> bool = {
	let name = strategy.toString();
	var i = 0;
	while (i < r.steps.length()) {
		if (r.steps.at(i).strategy.toString() == name) { return true; }
		i += 1;
	}
	return false;
}

# Every strategy is shown by at least one example.
fun check_coverage(examples: ref List[ExampleBoard]) -> bool = {
	let strategies = all_strategies();
	var covered: List[bool];
	var k = 0;
	while (k < strategies.length()) {
		covered.push(false);
		k += 1;
	}
	var i = 0;
	while (i < examples.length()) {
		var creator: Creator;
		creator.load(examples.at(i).board);
		k = 0;
		while (k < strategies.length()) {
			if (uses(&creator.result, strategies.at(k).name)) { covered.at(k) = true; }
			k += 1;
		}
		i += 1;
	}
	var ok = true;
	k = 0;
	while (k < strategies.length()) {
		ok = check(covered.at(k), f"no example uses {strategies.at(k).name}".asSlice()) and ok;
		k += 1;
	}
	return ok;
}

fun check_multiset() -> bool = {
	let values = [5, 3, 8, 1, 4, 7, 9, 2, 6, 3, 5, 5];
	var ms: Multiset[i64];
	for (v in values) { ms.add(v); }
	var ok = check(ms.count(3) == 2 and ms.count(5) == 3 and ms.count(10) == 0, "multiset count");
	ok = check(ms.min().valueOr(-1) == 1 and ms.max().valueOr(-1) == 9, "multiset min/max") and ok;
	for (v in [5, 5, 5, 9]) { ms.remove(v); }
	ok = check(ms.count(5) == 0 and ms.max().valueOr(-1) == 8, "multiset remove") and ok;
	for (v in values) { ms.remove(v); }
	ok = check(ms.min().isEmpty(), "multiset empty") and ok;

	# Enough keys to rotate in both directions.
	var big: Multiset[i64];
	var k = 0;
	while (k < 200) {
		big.add((k * 37) % 101);
		k += 1;
	}
	var all_present = true;
	k = 0;
	while (k < 101) {
		if (big.count(k) == 0) { all_present = false; }
		k += 1;
	}
	return check(all_present and big.min().valueOr(-1) == 0 and big.max().valueOr(-1) == 100, "multiset stress") and ok;
}

fun self_test() -> bool = {
	var ok = check_multiset();
	let examples = example_boards();
	var i = 0;
	while (i < examples.length()) {
		ok = check_example(examples.at(i)) and ok;
		i += 1;
	}
	ok = check_coverage(&examples) and ok;
	print(if ok then "ALL OK\n" else "SOME CHECKS FAILED\n");
	return ok;
}
