import core.containers.*;
import sdl2.*;
import SudokuCreator.gui.graphics.*;
import SudokuCreator.gui.board_view.*;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.explanation.*;
import SudokuCreator.sudoku_solver.strategies.*;
import SudokuCreator.sudoku_solver.SolveResult;
import SudokuCreator.sudoku_solver.difficulty.remaining_difficulty;

# Browses the solver's steps: each is drawn on the board as it was before its move.

# Indexed by Role.
let ROLE_COLORS = [
	rgb(255, 244, 200),  # Unit
	rgb(215, 230, 255),  # Excluded
	rgb(125, 170, 250),  # Excluder
	rgb(200, 170, 235),  # Pattern
	rgb(255, 210, 150),  # Target
	rgb(255, 130, 130),  # Eliminated
	rgb(150, 235, 160),  # Placed
];

fun draw_mark(canvas: Canvas, m: UnitMark) = {
	for (c in UNITS[m.unit].cells) { fill_cell(canvas, c, ROLE_COLORS[m.role]); }
}

fun draw_mark(canvas: Canvas, m: CellMark) = { fill_cell(canvas, m.cell, ROLE_COLORS[m.role]); }

fun draw_mark(canvas: Canvas, m: CandMark) = {
	canvas.fill(ROLE_COLORS[m.role], cand_x(m.cell, m.digit) - 9, cand_y(m.cell, m.digit) - 9, 18, 18);
}

# From the center of `from` to the near edge of `to`. The cells share a row or a column.
fun draw_mark(canvas: Canvas, m: LineMark) = {
	let x = cell_x(m.from) + CELL / 2;
	let y = cell_y(m.from) + CELL / 2;
	if (m.from.col == m.to.col) {
		canvas.thick_line(ROLE_COLORS[m.role], x, y, x, if m.to.row > m.from.row then cell_y(m.to) else cell_y(m.to) + CELL);
	} else {
		canvas.thick_line(ROLE_COLORS[m.role], x, y, if m.to.col > m.from.col then cell_x(m.to) else cell_x(m.to) + CELL, y);
	}
}

# Draws only the marks of type M, so that each kind can be its own layer.
template(M: type)
fun draw_marks(canvas: Canvas, step: ref Step) = {
	var i = 0;
	while (i < step.marks.length()) {
		match (step.marks.at(i)) {
			case m: M = draw_mark(canvas, m);
			case _ = ();
		};
		i += 1;
	}
}

fun places_in(step: ref Step, c: CellCoord) -> bool = {
	var i = 0;
	while (i < step.placements.length()) {
		if (step.placements.at(i).cell == c) { return true; }
		i += 1;
	}
	return false;
}

# The index of the move that step `step_idx` belongs to.
fun move_of(result: ref SolveResult, step_idx: i64) -> i64 = {
	var m = 0;
	while (m + 1 < result.move_start.length() and result.move_start.at(m + 1) <= step_idx) { m += 1; }
	return m;
}

class StepView {
	caption_font: cptr TTF_Font;
	panel_font: cptr TTF_Font;
	given: Text[10];
	solved: Text[10];       # entered by the solver in earlier moves
	placed: Text[10];       # entered by the current step
	candidates: Text[10];
	title: Text;
	legend: Text[7];        # indexed by Role
	contradiction_legend: Text;
	keys_help: Text;

	# Rendered for the current solve.
	move_lines: List[Text];
	# Rendered for the current step.
	shown: i64 = -1;
	difficulty: Text;
	header: Text;
	body: Text;

	global fun create(canvas: Canvas, large: cptr TTF_Font, medium: cptr TTF_Font, small: cptr TTF_Font) -> StepView = {
		var v: StepView;
		v.caption_font = medium;
		v.panel_font = small;
		v.given = canvas.make_digits(large, INK);
		v.solved = canvas.make_digits(large, ENTERED);
		v.placed = canvas.make_digits(large, rgb(0, 140, 40));
		v.candidates = canvas.make_digits(small, rgb(110, 110, 110));
		v.title = canvas.make_text(small, "Solver moves", rgb(30, 30, 30));
		let labels = [
			"the unit being searched",
			"area excluded by a digit",
			"the digit that excludes",
			"candidate forming the pattern",
			"target cell",
			"candidate being crossed out",
			"digit being entered",
		];
		var role = 0;
		for (label in labels) {
			v.legend[role] = canvas.make_text(small, label, rgb(60, 60, 60));
			role += 1;
		}
		v.contradiction_legend = canvas.make_text(small, "no candidates left (contradiction)", rgb(60, 60, 60));
		v.keys_help = canvas.make_text(small, "←/→ step   Esc editor", HINT);
		return v;
	}

	# Call before showing a new solve.
	fun reset() = {
		var i = 0;
		while (i < move_lines.length()) {
			move_lines.at(i).free();
			i += 1;
		}
		move_lines.clear();
		free_caption();
	}

	fun free_caption() = {
		if (shown >= 0) {
			difficulty.free();
			header.free();
			body.free();
		}
		shown = -1;
	}

	fun draw(canvas: Canvas, result: ref SolveResult, step_idx: i64) = {
		let step = result.steps.at(step_idx);
		let s = result.snapshots.at(step_idx);

		# Backgrounds: whole units first, then cells, then cells left without candidates.
		draw_board_background(canvas);
		draw_marks[UnitMark](canvas, step);
		draw_marks[CellMark](canvas, step);
		for (c in CELLS) {
			if (s.value(c) == 0 and s.count(c) == 0) { fill_cell(canvas, c, RED); }
		}
		draw_grid(canvas);
		draw_marks[LineMark](canvas, step);

		for (c in CELLS) {
			let d = s.value(c);
			if (d != 0) { draw_in_cell(canvas, if s.cell(c).given then given[d] else solved[d], c); }
		}
		var i = 0;
		while (i < step.placements.length()) {
			let p = step.placements.at(i);
			draw_in_cell(canvas, placed[p.digit], p.cell);
			i += 1;
		}

		draw_marks[CandMark](canvas, step);
		for (c in CELLS) {
			if (places_in(step, c)) { continue; }
			for (d in DIGITS) {
				if (s.has(c, d)) { canvas.text(candidates[d], cand_x(c, d), cand_y(c, d), true); }
			}
		}
		i = 0;
		while (i < step.eliminations.length()) {
			let e = step.eliminations.at(i);
			let x = cand_x(e.cell, e.digit);
			let y = cand_y(e.cell, e.digit);
			canvas.thick_line(rgb(200, 0, 0), x - 8, y + 8, x + 8, y - 8);
			i += 1;
		}

		draw_caption(canvas, result, step_idx);
		draw_panel(canvas, result, step_idx);
	}

	fun draw_caption(canvas: Canvas, result: ref SolveResult, step_idx: i64) = {
		if (shown != step_idx) {
			free_caption();
			let step = result.steps.at(step_idx);
			difficulty = canvas.make_text(caption_font, f"Remaining difficulty: {remaining_difficulty(result, step_idx)}", TEXT, 540u32);
			header = canvas.make_text(caption_font, f"Step {step_idx + 1}/{result.steps.length()} · move {move_of(result, step_idx) + 1}: {step.strategy}", TEXT, 540u32);
			body = canvas.make_text(caption_font, step.text.asSlice(), TEXT, 540u32);
			shown = step_idx;
		}
		canvas.text(difficulty, ORIGIN, CAPTION_Y);
		canvas.text(header, ORIGIN, CAPTION_Y + 25);
		canvas.text(body, ORIGIN, CAPTION_Y + 50 + body.h / 2);
	}

	# The move list, scrolled to keep the current move roughly centered, and the color legend.
	fun draw_panel(canvas: Canvas, result: ref SolveResult, step_idx: i64) = {
		if (move_lines.length() == 0) {
			var m = 0;
			while (m < result.move_start.length()) {
				let strategy = result.steps.at(result.move_start.at(m)).strategy;
				move_lines.push(canvas.make_text(panel_font, f"{m + 1}. {strategy}", TEXT, 300u32));
				m += 1;
			}
		}
		canvas.text(title, PANEL_X, ORIGIN + 8);

		# Laid out from the bottom up: key hints, the legend above them, the move list in what is left.
		let keys_y = HEIGHT - 16;
		let legend_y = keys_y - 20 - (Role.Count + 1) * LEGEND_ROW;
		let list_y = ORIGIN + 26;
		let row_h = 18;
		let rows = ((legend_y - 12 - list_y) / row_h) as i64;

		let current = move_of(result, step_idx);
		var first = current - rows / 2;
		if (first > move_lines.length() - rows) { first = move_lines.length() - rows; }
		if (first < 0) { first = 0; }
		var i = first;
		while (i < move_lines.length() and i < first + rows) {
			let row_y = list_y + ((i - first) as i32) * row_h;
			if (i == current) { canvas.fill(SELECTION, PANEL_X - 6, row_y, 300, row_h); }
			canvas.text(move_lines.at(i), PANEL_X, row_y + row_h / 2);
			i += 1;
		}

		var y = legend_y;
		var role = 0;
		while (role < Role.Count) {
			draw_legend_entry(canvas, ROLE_COLORS[role], legend[role], y);
			y += LEGEND_ROW;
			role += 1;
		}
		draw_legend_entry(canvas, RED, contradiction_legend, y);
		canvas.text(keys_help, PANEL_X, keys_y);
	}
}
