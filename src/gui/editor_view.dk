import sdl2.*;
import SudokuCreator.gui.graphics.*;
import SudokuCreator.gui.board_view.*;
import core.containers.*;
import SudokuCreator.creator.Creator;
import SudokuCreator.sudoku_solver.all_strategies;
import SudokuCreator.sudoku_solver.units.*;

# The difficulty of the hardest known strategy (the registry is ordered easiest first).
fun hardest_difficulty() -> f64 = {
	let strategies = all_strategies();
	return strategies.at(strategies.length() - 1).difficulty;
}

let MAX_DIFFICULTY = hardest_difficulty();

# Heatmap of how hard a cell is to fill in, spread evenly over the strategies' range: blue at
# difficulty 1 (the easiest), through green and yellow, to red for the hardest strategy.
fun difficulty_color(d: f64) -> Color = {
	let stops = [BLUE, GREEN, YELLOW, RED];
	let t = (d - 1.0) / (MAX_DIFFICULTY - 1.0) * 3.0;
	if (t <= 0.0) { return stops[0]; }
	if (t >= 3.0) { return stops[3]; }
	let i = t as i64;
	return lerp(stops[i], stops[i + 1], t - (i as f64));
}

# The board editor, with the heatmap on empty cells the strategies can fill in.
class EditorView {
	digits: Text[10];
	help: Text;
	unsolvable: Text;
	undetermined: Text;
	legend_title: Text;
	legend: List[Text];       # one per strategy, in the solver's order
	legend_colors: List[Color];
	undetermined_legend: Text;

	global fun create(canvas: Canvas, large: cptr TTF_Font, medium: cptr TTF_Font, small: cptr TTF_Font) -> EditorView = {
		var v: EditorView;
		v.digits = canvas.make_digits(large, ENTERED);
		v.help = canvas.make_text(medium, "Click a cell and type 1-9 · Space: solve · L: Load", HINT);
		v.unsolvable = canvas.make_text(medium, "This sudoku has no solution.", TEXT, 260u32);
		v.undetermined = canvas.make_text(medium, "Some cells can't be determined yet.", TEXT, 260u32);
		v.legend_title = canvas.make_text(small, "Hardest strategy needed to fill a cell:", rgb(30, 30, 30), 300u32);
		let strategies = all_strategies();
		var i = 0;
		while (i < strategies.length()) {
			let strategy = strategies.at(i);
			v.legend.push(canvas.make_text(small, f"{strategy.name} ({strategy.difficulty})", rgb(60, 60, 60)));
			v.legend_colors.push(difficulty_color(strategy.difficulty));
			i += 1;
		}
		v.undetermined_legend = canvas.make_text(small, "no known strategy can place it yet", rgb(60, 60, 60));
		return v;
	}

	# What the heatmap colors mean, below where the warnings go.
	fun draw_legend(canvas: Canvas) = {
		var y = ORIGIN + 80;
		canvas.text(legend_title, PANEL_X, y);
		y += legend_title.h / 2 + 10;
		var i = 0;
		while (i < legend.length()) {
			draw_legend_entry(canvas, legend_colors.at(i), legend.at(i), y);
			y += LEGEND_ROW;
			i += 1;
		}
		draw_legend_entry(canvas, WHITE, undetermined_legend, y);
		canvas.fill(rgb(180, 180, 180), PANEL_X, y, 18, 1);   # outline the white swatch
		canvas.fill(rgb(180, 180, 180), PANEL_X, y + 17, 18, 1);
		canvas.fill(rgb(180, 180, 180), PANEL_X, y, 1, 18);
		canvas.fill(rgb(180, 180, 180), PANEL_X + 17, y, 1, 18);
	}

	fun draw(canvas: Canvas, creator: ref Creator, selected: CellCoord) = {
		draw_board_background(canvas);
		for (c in CELLS) {
			if (creator.get(c) == 0 and creator.difficulty.placeable(c)) {
				fill_cell(canvas, c, difficulty_color(creator.difficulty.at(c)));
			}
		}
		fill_cell(canvas, selected, SELECTION);
		draw_grid(canvas);
		for (c in CELLS) {
			let d = creator.get(c);
			if (d != 0) { draw_in_cell(canvas, digits[d], c); }
		}
		canvas.text(help, ORIGIN, CAPTION_Y);

		draw_legend(canvas);
		if (creator.unsolvable) {
			draw_warning(canvas, unsolvable, rgb(255, 150, 150));
		} else if (creator.undetermined) {
			draw_warning(canvas, undetermined, rgb(255, 225, 120));
		}
	}
}

fun draw_warning(canvas: Canvas, t: Text, color: Color) = {
	let y = ORIGIN + 8;
	canvas.fill(color, PANEL_X, y, t.w + 20, t.h + 16);
	canvas.text(t, PANEL_X + 10, y + 8 + t.h / 2);
}
