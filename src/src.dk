import core.builtins.*;
import core.containers.*;
import core.optional.*;
import sdl2.*;
import SudokuCreator.graphics.*;
import SudokuCreator.board_view.*;
import SudokuCreator.creator.Creator;
import SudokuCreator.examples.*;
import SudokuCreator.editor_view.EditorView;
import SudokuCreator.example_dialog.ExampleDialog;
import SudokuCreator.step_view.StepView;
import SudokuCreator.headless.*;
import SudokuCreator.sudoku_solver.units.CellCoord;

# Sudoku Creator: a board editor with a live solvability heatmap.
#
# Editor: click or use the arrows to select a cell, 1-9 to enter a digit, 0, Backspace or Delete
# to clear it, Esc to quit. Space browses the solver's steps (left/right, Esc returns).
# L opens the example list (1-9 loads a board, Esc cancels).

namespace Mode {
	const Edit = 0;
	const Browse = 1;    # the solver's steps
	const Examples = 2;  # the example list
}

class Fonts {
	large: cptr TTF_Font;   # board digits, titles
	medium: cptr TTF_Font;  # text
	small: cptr TTF_Font;   # candidates

	global fun open() -> Fonts = {
		let path = cstr("assets/DejaVuSans.ttf\0");
		return Fonts(TTF_OpenFont(path, 36), TTF_OpenFont(path, 18), TTF_OpenFont(path, 14));
	}

	fun loaded() -> bool = large as u64 != 0u64 and medium as u64 != 0u64 and small as u64 != 0u64;

	fun close() = {
		TTF_CloseFont(large);
		TTF_CloseFont(medium);
		TTF_CloseFont(small);
	}
}

class App {
	canvas: Canvas;
	creator: Creator;
	examples: List[ExampleBoard];
	editor: EditorView;
	dialog: ExampleDialog;
	steps: StepView;
	mode: i64 = Mode.Edit;
	selected: CellCoord = CellCoord(4, 4);
	step: i64 = 0;
	running: bool = true;

	# Starts by browsing the solution of the last example.
	global fun create(screen: Canvas, fonts: ref Fonts) -> App = {
		var app: App;
		app.canvas = screen;
		app.examples = example_boards();
		app.editor = EditorView.create(screen, fonts.large, fonts.medium);
		app.dialog = ExampleDialog.create(screen, fonts.large, fonts.medium, &app.examples);
		app.steps = StepView.create(screen, fonts.large, fonts.medium, fonts.small);
		app.creator.load(app.examples.at(app.examples.length() - 1).board);
		app.browse();
		return app;
	}

	fun browse() = {
		if (creator.result.steps.length() == 0) { return; }
		steps.reset();
		step = 0;
		mode = Mode.Browse;
	}

	fun handle(event: cptr SDL_Event) = {
		let kind = SDL_Event_as_type(event)[0];
		if (kind == SDL_QUIT) {
			running = false;
		} else if (kind == SDL_MOUSEBUTTONDOWN and mode == Mode.Edit) {
			let button = SDL_Event_as_button(event)[0];
			let cell = cell_at(button.x, button.y);
			if (cell.nonEmpty()) { selected = cell.value(); }
		} else if (kind == SDL_KEYDOWN) {
			let key = SDL_Event_as_key(event)[0].keysym.sym as u32;
			if (mode == Mode.Edit) { on_edit_key(key); }
			else if (mode == Mode.Browse) { on_browse_key(key); }
			else { on_examples_key(key); }
		}
	}

	fun on_edit_key(key: u32) = {
		if (SDLK_1 <= key <= SDLK_9) { creator.set(selected, (key - SDLK_0) as i64); }
		else if (SDLK_KP_1 <= key <= SDLK_KP_9) { creator.set(selected, (key - SDLK_KP_1) as i64 + 1); }
		else if (key == SDLK_0 or key == SDLK_BACKSPACE or key == SDLK_DELETE) { creator.set(selected, 0); }
		else if (key == SDLK_UP and selected.row > 0) { selected.row -= 1; }
		else if (key == SDLK_DOWN and selected.row < 8) { selected.row += 1; }
		else if (key == SDLK_LEFT and selected.col > 0) { selected.col -= 1; }
		else if (key == SDLK_RIGHT and selected.col < 8) { selected.col += 1; }
		else if (key == SDLK_SPACE) { browse(); }
		else if (key == SDLK_l) { mode = Mode.Examples; }
		else if (key == SDLK_ESCAPE) { running = false; }
	}

	fun on_browse_key(key: u32) = {
		if (key == SDLK_RIGHT and step + 1 < creator.result.steps.length()) { step += 1; }
		else if (key == SDLK_LEFT and step > 0) { step -= 1; }
		else if (key == SDLK_ESCAPE) { mode = Mode.Edit; }
	}

	fun on_examples_key(key: u32) = {
		if (SDLK_1 <= key <= SDLK_9) {
			let i = (key - SDLK_1) as i64;
			if (i < examples.length()) { creator.load(examples.at(i).board); }
			mode = Mode.Edit;
		} else if (key == SDLK_ESCAPE) {
			mode = Mode.Edit;
		}
	}

	fun draw() = {
		canvas.clear(BACKGROUND);
		if (mode == Mode.Edit) { editor.draw(canvas, &creator, selected); }
		else if (mode == Mode.Browse) { steps.draw(canvas, &creator.result, step); }
		else { dialog.draw(canvas); }
		SDL_RenderPresent(canvas.renderer);
	}
}

fun main() -> i64 = {
	var headless = headless_arg();
	if (headless.nonEmpty()) { return run_headless(headless.value()); }

	if (SDL_Init(SDL_INIT_VIDEO) != 0) { return 1; }
	if (TTF_Init() != 0) { return 2; }
	let pos = SDL_WINDOWPOS_CENTERED as i32;
	let window = SDL_CreateWindow(cstr("Sudoku Creator\0"), pos, pos, WIDTH, HEIGHT, SDL_WINDOW_SHOWN);
	let canvas = Canvas(SDL_CreateRenderer(window, -1, 0u32));
	var fonts = Fonts.open();
	if (not fonts.loaded()) { return 3; }

	var app = App.create(canvas, &fonts);
	var event: SDL_Event;
	while (app.running) {
		while (SDL_PollEvent(&event as cptr SDL_Event) != 0) { app.handle(&event as cptr SDL_Event); }
		app.draw();
		SDL_Delay(16u32);
	}

	fonts.close();
	SDL_DestroyRenderer(canvas.renderer);
	SDL_DestroyWindow(window);
	TTF_Quit();
	SDL_Quit();
	return 0;
}
