import core.optional.*;
import SudokuCreator.gui.run_gui;
import SudokuCreator.headless.*;

# Sudoku Creator: a board editor with a live solvability heatmap. See headless.dk for the
# diagnostics run when SUDOKU_HEADLESS is set.

fun main() -> i64 = {
	var headless = headless_arg();
	if (headless.nonEmpty()) { return run_headless(headless.value()); }
	return run_gui();
}
