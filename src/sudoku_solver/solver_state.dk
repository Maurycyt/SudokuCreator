import core.containers.*;
import src.partial_sudoku.PartialSudoku;
import src.sudoku_solver.units.*;

# The solver's board: digits + candidates (see DESIGN.md, chapter 4).
class SolverState {
	class Cell {
		value: i64;          # 0 = empty
		given: bool;         # a digit from the puzzle (drawn in a different color)
		candidates: u8[9];   # candidates[d - 1] == 1 -> digit d is still possible
	}

	board: Cell[9][9];

	fun cell(c: CellCoord) -> ref Cell = &board[c.row][c.col];
	fun value(c: CellCoord) -> i64 = cell(c).value;
	fun has(c: CellCoord, d: i64) -> bool = cell(c).candidates[d - 1] != 0u8;

	fun count(c: CellCoord) -> i64 = {
		var n = 0;
		var d = 1;
		while (d <= 9) { if (has(c, d)) { n += 1; } d += 1; }
		return n;
	}

	fun first_candidate(c: CellCoord) -> i64 = {
		var d = 1;
		while (d <= 9 and not has(c, d)) { d += 1; }
		return d;
	}

	fun eliminate(c: CellCoord, d: i64) = { cell(c).candidates[d - 1] = 0u8; }

	# Places d in c and crosses out d from its peers (a human does this "in their head", not as its own step).
	fun place(c: CellCoord, d: i64) = {
		cell(c).value = d;
		var k = 1;
		while (k <= 9) { eliminate(c, k); k += 1; }
		let cells = all_cells();
		var i = 0;
		while (i < cells.length()) { let p = cells.at(i); if (sees(c, p)) { eliminate(p, d); } i += 1; }
	}

	fun solved() -> bool = {
		let cells = all_cells();
		var i = 0;
		while (i < cells.length()) { if (value(cells.at(i)) == 0) { return false; } i += 1; }
		return true;
	}

	# Whether digit d is already placed in unit u.
	fun unit_has(u: i64, d: i64) -> bool = {
		var k = 0;
		while (k < 9) { if (value(unit_cell(u, k)) == d) { return true; } k += 1; }
		return false;
	}

	global fun create(partial: PartialSudoku) -> SolverState = {
		var s: SolverState;
		let cells = all_cells();
		var i = 0;
		while (i < cells.length()) {
			let c = cells.at(i);
			var d = 1;
			while (d <= 9) { s.cell(c).candidates[d - 1] = 1u8; d += 1; }
			i += 1;
		}
		i = 0;
		while (i < cells.length()) {
			let c = cells.at(i);
			let v = partial.board[c.row][c.col].value;
			if (v != 0) { s.place(c, v); s.cell(c).given = true; }
			i += 1;
		}
		return s;
	}
}
