import core.containers.*;
import core.optional.*;
import SudokuCreator.sudoku_solver.partial_sudoku.PartialSudoku;
import SudokuCreator.sudoku_solver.units.*;

const ALL_CANDIDATES = 1022i64;  # bits 1..9

# The solver's board: placed digits, and the candidates still possible in each empty cell.
class SolverState {
	class Cell {
		value: i64;                          # 0 = empty
		given: bool;                         # entered by the user, not the solver
		candidates: i64 = ALL_CANDIDATES;    # bit d set = digit d still possible
	}

	board: Cell[9][9];

	global fun create(puzzle: ref PartialSudoku) -> SolverState = {
		var s: SolverState;
		for (c in CELLS) {
			let d = puzzle.at(c);
			if (d != 0) {
				s.place(c, d);
				s.cell(c).given = true;
			}
		}
		return s;
	}

	fun cell(c: CellCoord) -> ref Cell = &board[c.row][c.col];
	fun value(c: CellCoord) -> i64 = cell(c).value;
	fun has(c: CellCoord, d: i64) -> bool = ((cell(c).candidates >> d) & 1i64) != 0i64;

	fun count(c: CellCoord) -> i64 = {
		var n = 0;
		for (d in DIGITS) { if (has(c, d)) { n += 1; } }
		return n;
	}

	# The candidate of c, if it has exactly one.
	fun sole_candidate(c: CellCoord) -> ?i64 = {
		if (count(c) == 1) {
			for (d in DIGITS) { if (has(c, d)) { return d; } }
		}
		return none;
	}

	# The cells of the unit where d is still a candidate, in unit order.
	fun candidate_cells(unit: ref Unit, d: i64) -> List[CellCoord] = {
		var cells: List[CellCoord];
		for (c in unit.cells) { if (has(c, d)) { cells.push(c); } }
		return cells;
	}

	fun count_in(unit: ref Unit, d: i64) -> i64 = {
		var n = 0;
		for (c in unit.cells) { if (value(c) == d) { n += 1; } }
		return n;
	}

	fun eliminate(c: CellCoord, d: i64) = { cell(c).candidates &= ~(1i64 << d); }

	# Places d in c and removes it from the candidates of every cell that sees c.
	fun place(c: CellCoord, d: i64) = {
		cell(c).value = d;
		cell(c).candidates = 0;
		for (p in CELLS) { if (c.sees(p)) { eliminate(p, d); } }
	}

	fun solved() -> bool = {
		for (c in CELLS) { if (value(c) == 0) { return false; } }
		return true;
	}

	# Whether the board is provably unsolvable: a unit holds a digit twice, or an empty cell has
	# no candidates left.
	fun has_contradiction() -> bool = {
		for (unit in UNITS) {
			for (d in DIGITS) { if (count_in(&unit, d) > 1) { return true; } }
		}
		for (c in CELLS) { if (value(c) == 0 and cell(c).candidates == 0) { return true; } }
		return false;
	}
}
