import src.partial_sudoku.PartialSudoku;
import src.sudoku_solver.units.*;

# Plansza solvera: cyfry + kandydaci (DESIGN.md, rozdz. 4).
class SolverState {
	class Cell {
		value: i64;          # 0 = puste
		given: bool;         # cyfra z zadania (rysowana innym kolorem)
		candidates: u8[9];   # candidates[d - 1] == 1 -> cyfra d jeszcze możliwa
	}

	board: Cell[9][9];

	fun cell(c: i64) -> ref Cell = &board[row_of(c)][col_of(c)];
	fun value(c: i64) -> i64 = cell(c).value;
	fun has(c: i64, d: i64) -> bool = cell(c).candidates[d - 1] != 0u8;

	fun count(c: i64) -> i64 = {
		var n = 0;
		var d = 1;
		while (d <= 9) { if (has(c, d)) { n += 1; } d += 1; }
		return n;
	}

	fun first_candidate(c: i64) -> i64 = {
		var d = 1;
		while (d <= 9 and not has(c, d)) { d += 1; }
		return d;
	}

	fun eliminate(c: i64, d: i64) = { cell(c).candidates[d - 1] = 0u8; }

	# Wpisuje d w c i skreśla d u sąsiadów (to człowiek robi "w głowie", nie osobny krok).
	fun place(c: i64, d: i64) = {
		cell(c).value = d;
		var k = 1;
		while (k <= 9) { eliminate(c, k); k += 1; }
		var p = 0;
		while (p < 81) { if (sees(c, p)) { eliminate(p, d); } p += 1; }
	}

	fun solved() -> bool = {
		var c = 0;
		while (c < 81) { if (value(c) == 0) { return false; } c += 1; }
		return true;
	}

	# Czy cyfra d jest już wpisana w jednostce u.
	fun unit_has(u: i64, d: i64) -> bool = {
		var k = 0;
		while (k < 9) { if (value(unit_cell(u, k)) == d) { return true; } k += 1; }
		return false;
	}

	global fun create(partial: PartialSudoku) -> SolverState = {
		var s: SolverState;
		var c = 0;
		while (c < 81) {
			var d = 1;
			while (d <= 9) { s.cell(c).candidates[d - 1] = 1u8; d += 1; }
			c += 1;
		}
		c = 0;
		while (c < 81) {
			let v = partial.board[row_of(c)][col_of(c)].value;
			if (v != 0) { s.place(c, v); s.cell(c).given = true; }
			c += 1;
		}
		return s;
	}
}
