import core.containers.*;
import core.optional.*;
import SudokuCreator.multiset.*;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.*;

# How hard each empty cell is to fill in, given the digits entered so far.
class CellDifficulty {
	board: f64[9][9];  # negative = no known strategy places the cell

	# A cell's difficulty is the hardest strategy used up to and including the move that placed
	# it: a hard move can unlock easy ones, which are then no easier to reach.
	global fun of(result: ref SolveResult) -> CellDifficulty = {
		var cd: CellDifficulty;
		for (c in CELLS) { cd.at(c) = -1.0; }
		var hardest: f64 = -1.0;
		var i = 0;
		while (i < result.steps.length()) {
			let step = result.steps.at(i);
			if (step.difficulty > hardest) { hardest = step.difficulty; }
			var k = 0;
			while (k < step.placements.length()) {
				cd.at(step.placements.at(k).cell) = hardest;
				k += 1;
			}
			i += 1;
		}
		return cd;
	}

	fun at(c: CellCoord) -> ref f64 = &board[c.row][c.col];
	fun placeable(c: CellCoord) -> bool = at(c) >= 0.0;
}

# Rounds to one decimal place, so repeated +0.1 does not drift.
fun round_tenth(x: f64) -> f64 = ((x * 10.0 + 0.5) as i64) as f64 / 10.0;

# The difficulty of the steps from `from` onwards: any two steps of equal difficulty X combine
# into one of difficulty X + 0.1 until no two are tied, then the hardest remaining counts. So many
# easy steps add up to slightly more than one, and the value gently drops while solving.
fun remaining_difficulty(result: ref SolveResult, from: i64) -> f64 = {
	var ms: Multiset[f64];
	var i = from;
	while (i < result.steps.length()) {
		var v = round_tenth(result.steps.at(i).difficulty);
		ms.add(v);
		while (ms.count(v) >= 2) {
			ms.remove(v);
			ms.remove(v);
			v = round_tenth(v + 0.1);
			ms.add(v);
		}
		i += 1;
	}
	return ms.max().valueOr(0.0);
}
