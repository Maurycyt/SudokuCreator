import core.containers.*;
import src.sudoku_solver.units.*;
import src.sudoku_solver.solver_state.SolverState;
import src.sudoku_solver.strategies.*;
import src.sudoku_solver.*;

# Per-cell solvability, for the live editor view: for each currently empty cell, how hard would
# it be to fill it in right now, given only the cells already entered. A strategy does not have
# to touch a cell to make it solvable indirectly through others, so this just replays a full
# solve() and remembers, for every cell a step places, which strategy's difficulty did it.

class CellDifficulty {
	board: f64[9][9];  # a negative value means no known strategy can currently place that cell
}

# solve() always retries the easiest strategy first, so moves come out in nondecreasing
# difficulty within whatever a given move unlocks — but a single hard move can unlock further
# easy ones. A cell placed by an easy move that only became possible after an earlier hard move
# is itself no easier to reach, so each cell is colored by the hardest difficulty used by any
# move up to and including the one that placed it, not just that move's own difficulty.
fun analyze_difficulty(result: ref SolveResult) -> CellDifficulty = {
	var cd: CellDifficulty;
	var row = 0;
	while (row < 9) {
		var col = 0;
		while (col < 9) { cd.board[row][col] = 0.0 - 1.0; col += 1; }
		row += 1;
	}

	var hardest_so_far: f64 = 0.0 - 1.0;
	var i = 0;
	while (i < result.steps.length()) {
		let st = result.steps.at(i);
		if (st.difficulty > hardest_so_far) { hardest_so_far = st.difficulty; }
		var k = 0;
		while (k < st.placements.length()) {
			let p = st.placements.at(k);
			cd.board[p.cell.row][p.cell.col] = hardest_so_far;
			k += 1;
		}
		i += 1;
	}
	return cd;
}

# A provable contradiction in `s`: either two cells in a unit already hold the same digit, or
# some empty cell has no candidate left at all. Both are proof the board has no solution — but
# the second can easily be true of `s` without being true of the raw given digits alone, since a
# chain of otherwise-sound eliminations (singles, X-Wing, ...) can be what drove a cell's
# candidates to zero. So this should be checked against the state a solve() leaves behind, not
# a fresh one, or such contradictions go unnoticed.
fun has_contradiction(s: ref SolverState) -> bool = {
	var u = 0;
	while (u < 27) {
		var seen: bool[10];
		var d = 0;
		while (d < 10) { seen[d] = false; d += 1; }
		var k = 0;
		while (k < 9) {
			let v = s.value(unit_cell(u, k));
			if (v != 0) {
				if (seen[v]) { return true; }
				seen[v] = true;
			}
			k += 1;
		}
		u += 1;
	}

	let cells = all_cells();
	var i = 0;
	while (i < cells.length()) {
		let c = cells.at(i);
		if (s.value(c) == 0 and s.count(c) == 0) { return true; }
		i += 1;
	}
	return false;
}
