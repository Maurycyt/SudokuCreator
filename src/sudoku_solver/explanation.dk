# Co kolorować na planszy (DESIGN.md, rozdz. 5): strategia nie rysuje, tylko OPISUJE.
# Role to semantyka; kolory dobiera GUI (src/step_view.dk).

namespace Role {
	const Unit = 0;       # jednostka, w której szukamy (żółta)
	const Excluded = 1;   # wiersz/kolumna/kwadrat wykluczony przez cyfrę (jasnoniebieski)
	const Excluder = 2;   # cyfra, która wyklucza (mocny niebieski)
	const Pattern = 3;    # kandydat tworzący wzór
	const Target = 4;     # pole, w którym nastąpi efekt
	const Eliminated = 5; # skreślany kandydat
	const Placed = 6;     # wpisywana cyfra (zielona)
}

class UnitMark { unit: i64; role: i64; }
class CellMark { cell: i64; role: i64; }
class CandMark { cell: i64; digit: i64; role: i64; }

# Jedno kolorowanie: całej jednostki, komórki albo kandydata. GUI rozróżnia je przez match.
const Mark = UnitMark | CellMark | CandMark;
