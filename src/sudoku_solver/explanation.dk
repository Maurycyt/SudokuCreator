import SudokuCreator.sudoku_solver.units.CellCoord;

# What a step highlights on the board. Roles carry meaning only; the step viewer picks colors.

namespace Role {
	const Unit = 0;       # the unit being searched
	const Excluded = 1;   # an area excluded by a digit
	const Excluder = 2;   # the digit that excludes
	const Pattern = 3;    # a candidate forming the pattern
	const Target = 4;     # the cell where the effect happens
	const Eliminated = 5; # a candidate being crossed out
	const Placed = 6;     # a digit being entered
	const Count = 7;
}

class UnitMark { unit: i64; role: i64; }
class CellMark { cell: CellCoord; role: i64; }
class CandMark { cell: CellCoord; digit: i64; role: i64; }
class LineMark { from: CellCoord; to: CellCoord; role: i64; }

const Mark = UnitMark | CellMark | CandMark | LineMark;
