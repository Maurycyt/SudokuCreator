import core.containers.*;

# Board geometry. Rows and columns are 0..8 and digits 1..9. The 27 units are numbered
# 0-8 (rows), 9-17 (columns) and 18-26 (boxes, left to right, top to bottom).

class CellCoord {
	row: i64;
	col: i64;

	fun ==(other: CellCoord) -> bool = row == other.row and col == other.col;
	fun !=(other: CellCoord) -> bool = not (self == other);

	fun box_index() -> i64 = (row / 3) * 3 + col / 3;

	# Whether the two cells are distinct and share a unit.
	fun sees(other: CellCoord) -> bool =
		self != other and (row == other.row or col == other.col or box_index() == other.box_index());

	fun name() -> String = f"row {row + 1}, column {col + 1}";
}

class Unit {
	id: i64;
	cells: CellCoord[9];

	# 1-based; a box is named by its band and stack, e.g. box (2,1) is the middle-left one.
	fun name() -> String = {
		if (id < 9) { return f"row {id + 1}"; }
		if (id < 18) { return f"column {id - 8}"; }
		let b = id - 18;
		return f"box ({b / 3 + 1},{b % 3 + 1})";
	}
}

fun make_unit(id: i64) -> Unit = {
	var unit: Unit;
	unit.id = id;
	var k = 0;
	while (k < 9) {
		if (id < 9) {
			unit.cells[k] = CellCoord(id, k);
		} else if (id < 18) {
			unit.cells[k] = CellCoord(k, id - 9);
		} else {
			let b = id - 18;
			unit.cells[k] = CellCoord((b / 3) * 3 + k / 3, (b % 3) * 3 + k % 3);
		}
		k += 1;
	}
	return unit;
}

fun make_units() -> Unit[27] = {
	var units: Unit[27];
	var id = 0;
	while (id < 27) { units[id] = make_unit(id); id += 1; }
	return units;
}

# Every cell, row by row.
fun make_cells() -> CellCoord[81] = {
	var cells: CellCoord[81];
	var i = 0;
	while (i < 81) { cells[i] = CellCoord(i / 9, i % 9); i += 1; }
	return cells;
}

let UNITS = make_units();
let CELLS = make_cells();
let DIGITS = [1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64];
