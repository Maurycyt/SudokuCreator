import core.containers.*;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.solver_state.SolverState;
import SudokuCreator.sudoku_solver.explanation.*;
import SudokuCreator.sudoku_solver.strategies.*;

# X-Wing: in each of two rows, digit d has exactly two candidates, and they lie in the same two
# columns. Each of those columns then holds d in one of the two rows, so d can be eliminated
# from the rest of both columns. The same holds with rows and columns swapped.

fun find_x_wing(s: ref SolverState, sb: ref StepsBuilder) -> bool = {
	for (first_line in [0i64, 9i64]) {  # rows, then columns
		for (d in DIGITS) {
			var a = first_line;
			while (a < first_line + 9) {
				let in_a = s.candidate_cells(&UNITS[a], d);
				var b = a + 1;
				while (in_a.length() == 2 and b < first_line + 9) {
					let in_b = s.candidate_cells(&UNITS[b], d);
					if (in_b.length() == 2 and try_x_wing(s, sb, d, &UNITS[a], &UNITS[b], &in_a, &in_b)) { return true; }
					b += 1;
				}
				a += 1;
			}
		}
	}
	return false;
}

# The unit crossing `line` at c: c's column if `line` is a row, c's row if it is a column.
fun crossing_unit(line: ref Unit, c: CellCoord) -> i64 = if line.id < 9 then 9 + c.col else c.row;

fun abs(x: i64) -> i64 = if x < 0 then -x else x;
fun distance(a: CellCoord, b: CellCoord) -> i64 = abs(a.row - b.row) + abs(a.col - b.col);

# Of the pattern cells p and q, the one farther from c, so a line from c to it passes the other.
fun farther(c: CellCoord, p: CellCoord, q: CellCoord) -> CellCoord =
	if distance(c, p) >= distance(c, q) then p else q;

# `in_a` and `in_b` are the two candidate cells for d in line_a and line_b.
fun try_x_wing(s: ref SolverState, sb: ref StepsBuilder, d: i64, line_a: ref Unit, line_b: ref Unit,
		in_a: ref List[CellCoord], in_b: ref List[CellCoord]) -> bool = {
	let cross_1 = crossing_unit(line_a, in_a.at(0));
	let cross_2 = crossing_unit(line_a, in_a.at(1));
	if (cross_1 != crossing_unit(line_b, in_b.at(0)) or cross_2 != crossing_unit(line_b, in_b.at(1))) { return false; }

	var targets: List[CellCoord];
	var anchors: List[CellCoord];  # where each target's connecting line ends
	for (k in [0i64, 1i64]) {
		let p = in_a.at(k);
		let q = in_b.at(k);
		for (c in UNITS[crossing_unit(line_a, p)].cells) {
			if (s.has(c, d) and c != p and c != q) {
				targets.push(c);
				anchors.push(farther(c, p, q));
			}
		}
	}
	if (targets.length() == 0) { return false; }

	let crosses = f"{UNITS[cross_1].name()} and {UNITS[cross_2].name()}";
	sb.step(f"{line_a.name()} and {line_b.name()} can only place digit {d} in {crosses}, forming an X-Wing.");
	sb.cell(in_a.at(0), Role.Pattern);
	sb.cell(in_a.at(1), Role.Pattern);
	sb.cell(in_b.at(0), Role.Pattern);
	sb.cell(in_b.at(1), Role.Pattern);
	var i = 0;
	while (i < targets.length()) {
		sb.line(targets.at(i), anchors.at(i), Role.Excluder);
		i += 1;
	}
	sb.step_keep(f"So digit {d} can be eliminated from {crosses} everywhere else.");
	i = 0;
	while (i < targets.length()) {
		sb.eliminate(targets.at(i), d);
		i += 1;
	}
	return true;
}
