import core.containers.*;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.solver_state.SolverState;
import SudokuCreator.sudoku_solver.explanation.*;

# A strategy looks for one move without changing the state. If it finds one, it records the
# steps explaining it and returns true. Each step is one frame of the step viewer; the move's
# effects are taken from the last step.

class CandRef { cell: CellCoord; digit: i64; }

class Step {
	strategy: str = "";           # set by the solver
	difficulty: f64;              # set by the solver
	text: String;                 # caption
	marks: List[Mark];
	placements: List[CandRef];
	eliminations: List[CandRef];
}

class Strategy {
	name: str;
	difficulty: f64;
	find: funptr(ref SolverState, ref StepsBuilder) -> bool;
}

# Usage: sb.step("..."); sb.unit(u, Role.Unit); sb.step_keep("..."); sb.place(c, d);
class StepsBuilder {
	steps: List[Step];

	fun cur() -> ref Step = steps.at(steps.length() - 1);

	fun step(text: String) = {
		var s: Step;
		s.text = move text;
		steps.push(move s);
	}

	# A new step continuing the previous one: its marks and effects carry over.
	fun step_keep(text: String) = {
		var s = copy cur();
		s.text = move text;
		steps.push(move s);
	}

	fun unit(u: i64, role: i64) = { cur().marks.push(UnitMark(u, role)); }
	fun cell(c: CellCoord, role: i64) = { cur().marks.push(CellMark(c, role)); }
	fun cand(c: CellCoord, d: i64, role: i64) = { cur().marks.push(CandMark(c, d, role)); }
	fun line(from: CellCoord, to: CellCoord, role: i64) = { cur().marks.push(LineMark(from, to, role)); }

	# Effects; each is also marked on the board.
	fun place(c: CellCoord, d: i64) = { cur().placements.push(CandRef(c, d)); cell(c, Role.Placed); }
	fun eliminate(c: CellCoord, d: i64) = { cur().eliminations.push(CandRef(c, d)); cand(c, d, Role.Eliminated); }
}
