import core.containers.*;
import SudokuCreator.sudoku_solver.units.*;
import SudokuCreator.sudoku_solver.solver_state.SolverState;
import SudokuCreator.sudoku_solver.explanation.*;
import SudokuCreator.sudoku_solver.strategies.*;

# Strategies that place a single digit, explained in two steps: the reasoning, then the placement.

# Full House: a unit has one empty cell left.
fun find_full_house(s: ref SolverState) -> List[Step] = {
	var steps: List[Step];
	var sb = StepsBuilder(&steps);
	for (unit in UNITS) {
		var empty: CellCoord;
		var empty_count = 0;
		for (c in unit.cells) {
			if (s.value(c) == 0) { empty = c; empty_count += 1; }
		}
		if (empty_count != 1) { continue; }
		let d = s.sole_candidate(empty);
		if (d.isEmpty()) { continue; }  # only possible on a board with a contradiction

		sb.step(f"{unit.name()} has one empty cell left.");
		sb.unit(unit.id, Role.Unit);
		sb.step_keep(f"Only {d.value()} is missing from it.");
		sb.place(empty, d.value());
		return steps;
	}
	return steps;
}

# Hidden Single: a digit has one possible cell left in a unit. Boxes are searched first, as a
# human would.
fun find_hidden_single(s: ref SolverState) -> List[Step] = {
	var steps: List[Step];
	var sb = StepsBuilder(&steps);
	var i = 0;
	while (i < 27) {
		let unit = UNITS[(i + 18) % 27];
		i += 1;
		for (d in DIGITS) {
			let cells = s.candidate_cells(&unit, d);
			if (cells.length() != 1 or s.count_in(&unit, d) > 0) { continue; }

			let target = cells.at(0);
			sb.step(f"In {unit.name()}, all cells but one cannot contain digit {d}, because they share a row, column, or box with another cell that already contains it.");
			sb.unit(unit.id, Role.Unit);
			for (c in unit.cells) {
				if (c != target and s.value(c) == 0) { mark_exclusion(s, c, d, &sb); }
			}
			sb.step_keep(f"So digit {d} can only go in {target.name()}.");
			sb.place(target, d);
			return steps;
		}
	}
	return steps;
}

# Naked Single: a cell has exactly one candidate.
fun find_naked_single(s: ref SolverState) -> List[Step] = {
	var steps: List[Step];
	var sb = StepsBuilder(&steps);
	for (c in CELLS) {
		let d = s.sole_candidate(c);  # filled cells have no candidates
		if (d.isEmpty()) { continue; }

		sb.step(f"At {c.name()}, all digits but one are excluded, because each already appears in its row, column, or box.");
		for (e in DIGITS) {
			if (e != d.value()) { mark_exclusion(s, c, e, &sb); }
		}
		sb.step_keep(f"So only {d.value()} fits there.");
		sb.place(c, d.value());
		return steps;
	}
	return steps;
}

# Marks a cell holding d that excludes d from c: connected by a line when they share a row or
# column, otherwise by highlighting their shared box.
fun mark_exclusion(s: ref SolverState, c: CellCoord, d: i64, sb: ref StepsBuilder) = {
	for (p in CELLS) {
		if (s.value(p) != d or not c.sees(p)) { continue; }
		if (p.row == c.row or p.col == c.col) {
			sb.line(c, p, Role.Excluder);
		} else {
			sb.unit(18 + p.box_index(), Role.Excluded);
		}
		sb.cell(p, Role.Excluder);
		return;
	}
}
