import core.containers.*;
import src.sudoku_solver.solver_state.SolverState;
import src.sudoku_solver.explanation.*;

# Format strategii (DESIGN.md, rozdz. 6).
# Strategia nie zmienia stanu: find(stan) zwraca listę kroków do pokazania (pusta = nic nie znalazła).
# Jeden krok = jedno wciśnięcie strzałki w prawo: co pokolorować + podpis na dole.
# Efekty ruchu (wpisania/skreślenia) solver bierze z OSTATNIEGO kroku listy.

class CandRef { cell: i64; digit: i64; }

class Step {
	strategy: String;             # nazwa strategii (ustawia solver)
	text: String;                 # podpis pod planszą
	marks: List[Mark];            # co pokolorować
	placements: List[CandRef];    # wpisania (tylko single)
	eliminations: List[CandRef];  # skreślenia
}

class Strategy {
	name: str;
	difficulty: f64;
	find: funptr(ref SolverState) -> List[Step];
}

# Buduje listę kroków: sb.step("..."); sb.unit(u, Role.Unit); sb.place(c, d); ...
class StepsBuilder {
	steps: List[Step];

	fun cur() -> ref Step = steps.at(steps.length() - 1);

	fun step(text: String) = {
		var s: Step;
		s.text = move text;
		steps.push(move s);
	}
	# Nowy krok zaczynający od kopii poprzedniego (kolorowania i efekty zostają).
	fun step_keep(text: String) = {
		var s = copy cur();
		s.text = move text;
		steps.push(move s);
	}
	fun unit(u: i64, role: i64) = { cur().marks.push(UnitMark(u, role)); }
	fun cell(c: i64, role: i64) = { cur().marks.push(CellMark(c, role)); }
	fun cand(c: i64, d: i64, role: i64) = { cur().marks.push(CandMark(c, d, role)); }
	# Efekty: zapisuje ruch i od razu oznacza go do narysowania.
	fun place(c: i64, d: i64) = { cur().placements.push(CandRef(c, d)); cell(c, Role.Placed); }
	fun eliminate(c: i64, d: i64) = { cur().eliminations.push(CandRef(c, d)); cand(c, d, Role.Eliminated); }
}
