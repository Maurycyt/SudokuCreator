import core.containers.*;
import src.sudoku_solver.units.*;
import src.sudoku_solver.solver_state.SolverState;
import src.sudoku_solver.explanation.*;

# Strategy format (see DESIGN.md, chapter 6).
# A strategy does not change the state: find(state) returns a list of steps to show (empty = found nothing).
# One step = one press of the right arrow: what to color + a caption at the bottom.
# The solver takes a move's effects (placements/eliminations) from the LAST step in the list.

class CandRef { cell: CellCoord; digit: i64; }

class Step {
	strategy: String;             # strategy name (set by the solver)
	text: String;                 # caption below the board
	units: List[UnitMark];        # what to color
	cells: List[CellMark];
	cands: List[CandMark];
	placements: List[CandRef];    # placements (singles only)
	eliminations: List[CandRef];  # eliminations
}

class Strategy {
	name: str;
	difficulty: f64;
	find: funptr(ref SolverState) -> List[Step];
}

# Builds a list of steps: sb.step("..."); sb.unit(u, Role.Unit); sb.place(c, d); ...
class StepsBuilder {
	steps: List[Step];

	fun cur() -> ref Step = steps.at(steps.length() - 1);

	fun step(text: String) = {
		var s: Step;
		s.text = move text;
		steps.push(move s);
	}
	# A new step that starts as a copy of the previous one (colors and effects carry over).
	fun step_keep(text: String) = {
		var s = copy cur();
		s.text = move text;
		steps.push(move s);
	}
	fun unit(u: i64, role: i64) = { cur().units.push(UnitMark(u, role)); }
	fun cell(c: CellCoord, role: i64) = { cur().cells.push(CellMark(c, role)); }
	fun cand(c: CellCoord, d: i64, role: i64) = { cur().cands.push(CandMark(c, d, role)); }
	# Effects: records the move and immediately marks it to be drawn.
	fun place(c: CellCoord, d: i64) = { cur().placements.push(CandRef(c, d)); cell(c, Role.Placed); }
	fun eliminate(c: CellCoord, d: i64) = { cur().eliminations.push(CandRef(c, d)); cand(c, d, Role.Eliminated); }
}
