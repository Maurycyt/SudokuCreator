import core.containers.*;
import src.sudoku_solver.units.*;
import src.sudoku_solver.solver_state.SolverState;
import src.sudoku_solver.explanation.*;
import src.sudoku_solver.strategies.*;

# The simplest strategies. Each one places a single digit.
# Steps: first the result (the digit in green), then the explanation.

# Full House: a unit has one empty cell left.
fun find_full_house(s: ref SolverState) -> List[Step] = {
	var sb: StepsBuilder;
	var u = 0;
	while (u < 27 and sb.steps.length() == 0) {
		var empty: CellCoord;
		var count = 0;
		var k = 0;
		while (k < 9) {
			let c = unit_cell(u, k);
			if (s.value(c) == 0) { empty = c; count += 1; }
			k += 1;
		}
		if (count == 1) {
			let d = s.first_candidate(empty);
			sb.step(f"{unit_name(u)} has one empty cell left, and only {d} is missing from it.");
			sb.unit(u, Role.Unit);
			sb.place(empty, d);
		}
		u += 1;
	}
	return copy sb.steps;
}

# Hidden Single: digit d has one possible place left in a unit.
# Order like a human would: boxes first (18..26), then rows and columns.
fun find_hidden_single(s: ref SolverState) -> List[Step] = {
	var sb: StepsBuilder;
	var i = 0;
	while (i < 27 and sb.steps.length() == 0) {
		let u = (i + 18) % 27;
		var d = 1;
		while (d <= 9 and sb.steps.length() == 0) {
			var target: CellCoord;
			var count = 0;
			var k = 0;
			while (k < 9) {
				let c = unit_cell(u, k);
				if (s.has(c, d)) { target = c; count += 1; }
				k += 1;
			}
			if (count == 1 and not s.unit_has(u, d)) {
				sb.step(f"In {unit_name(u)}, digit {d} can only go in {cell_name(target)}.");
				sb.unit(u, Role.Unit);
				sb.place(target, d);
				sb.step_keep(f"Why? The other cells of {unit_name(u)} exclude digit {d} through a shared row, column, or box.");
				explain_excluders(s, u, d, target, &sb);
			}
			d += 1;
		}
		i += 1;
	}
	return copy sb.steps;
}

# For each empty cell of unit u other than target, finds a placed d that excludes it:
# its row/column/box is highlighted light blue, the digit itself in strong blue.
fun explain_excluders(s: ref SolverState, u: i64, d: i64, target: CellCoord, sb: ref StepsBuilder) = {
	var k = 0;
	while (k < 9) {
		let c = unit_cell(u, k);
		if (not same_cell(c, target) and s.value(c) == 0) {
			let cells = all_cells();
			var i = 0;
			var found = false;
			while (i < cells.length() and not found) {
				let p = cells.at(i);
				if (s.value(p) == d and sees(c, p)) {
					found = true;
					var w = 0;
					while (w < 3) {   # the first unit shared by p and c, other than u
						if (unit_of(p, w) == unit_of(c, w) and unit_of(p, w) != u) { sb.unit(unit_of(p, w), Role.Excluded); w = 3; }
						w += 1;
					}
					sb.cell(p, Role.Excluder);
				}
				i += 1;
			}
		}
		k += 1;
	}
}

# Naked Single: a cell has exactly one candidate.
fun find_naked_single(s: ref SolverState) -> List[Step] = {
	var sb: StepsBuilder;
	let cells = all_cells();
	var i = 0;
	while (i < cells.length() and sb.steps.length() == 0) {
		let c = cells.at(i);
		if (s.value(c) == 0 and s.count(c) == 1) {
			let d = s.first_candidate(c);
			sb.step(f"Only {d} fits in {cell_name(c)}.");
			sb.place(c, d);
			sb.step_keep(f"Why? Every other digit is already in the row, column, or box of {cell_name(c)}.");
			sb.unit(unit_of(c, 0), Role.Excluded);
			sb.unit(unit_of(c, 1), Role.Excluded);
			sb.unit(unit_of(c, 2), Role.Excluded);
		}
		i += 1;
	}
	return copy sb.steps;
}
