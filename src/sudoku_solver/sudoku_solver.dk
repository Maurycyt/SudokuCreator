import core.containers.*;
import partial_sudoku.PartialSudoku;
import solver_state.SolverState;
import strategies.*;
import strategies.singles.*;
import strategies.locked_candidates.*;
import strategies.subsets.*;
import strategies.fish.*;
import strategies.xy_wing.*;
import strategies.phistomefel.*;

# Easiest first; difficulties roughly follow Sudoku Explainer's ratings.
fun all_strategies() -> List[Strategy] = {
	var s: List[Strategy];
	s.push(Strategy("Full House", 1.0, find_full_house));
	s.push(Strategy("Hidden Single", 1.2, find_hidden_single));
	s.push(Strategy("Naked Single", 2.3, find_naked_single));
	s.push(Strategy("Pointing", 2.6, find_locked[true]));
	s.push(Strategy("Claiming", 2.8, find_locked[false]));
	s.push(Strategy("Naked Pair", 3.0, NakedSubset[2].find));
	s.push(Strategy("Hidden Pair", 3.4, HiddenSubset[2].find));
	s.push(Strategy("X-Wing", 3.5, Fish[2].find));
	s.push(Strategy("Naked Triple", 3.6, NakedSubset[3].find));
	s.push(Strategy("Swordfish", 3.8, Fish[3].find));
	s.push(Strategy("Hidden Triple", 4.0, HiddenSubset[3].find));
	s.push(Strategy("XY-Wing", 4.2, find_xy_wing));
	s.push(Strategy("Naked Quad", 5.0, NakedSubset[4].find));
	s.push(Strategy("Jellyfish", 5.2, Fish[4].find));
	s.push(Strategy("Hidden Quad", 5.4, HiddenSubset[4].find));
	s.push(Strategy("Phistomefel Ring", 6.0, find_phistomefel));  # not rated by Sudoku Explainer
	return s;
}

# The steps of all moves, in order. A move is one application of a strategy.
class SolveResult {
	steps: List[Step];
	snapshots: List[SolverState];  # the state each step is shown on, i.e. before its move
	move_start: List[i64];         # index of the first step of each move
	stuck: bool;                   # no strategy applies to the final state
}

class SudokuSolver {
	state: SolverState;

	global fun create(puzzle: ref PartialSudoku) = SudokuSolver(SolverState.create(puzzle));

	# After every move, starts over from the easiest strategy, so each move is as simple as possible.
	fun solve() -> SolveResult = {
		let strategies = all_strategies();
		var r: SolveResult;
		while (not state.solved()) {
			var i = 0;
			while (i < strategies.length() and not try_strategy(strategies.at(i), &r)) { i += 1; }
			if (i == strategies.length()) {
				r.stuck = true;
				break;
			}
		}
		return r;
	}

	fun try_strategy(strategy: ref Strategy, r: ref SolveResult) -> bool = {
		var steps = strategy.find(&state);
		if (steps.length() == 0) { return false; }

		r.move_start.push(r.steps.length());
		var k = 0;
		while (k < steps.length()) {
			var step = copy steps.at(k);
			step.strategy = strategy.name;
			step.difficulty = strategy.difficulty;
			r.snapshots.push(state);
			r.steps.push(move step);
			k += 1;
		}
		apply(steps.at(steps.length() - 1));
		return true;
	}

	fun apply(step: ref Step) = {
		var k = 0;
		while (k < step.placements.length()) {
			let p = step.placements.at(k);
			state.place(p.cell, p.digit);
			k += 1;
		}
		k = 0;
		while (k < step.eliminations.length()) {
			let e = step.eliminations.at(k);
			state.eliminate(e.cell, e.digit);
			k += 1;
		}
	}
}
