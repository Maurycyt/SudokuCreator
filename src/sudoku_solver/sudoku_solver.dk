import core.containers.*;
import SudokuCreator.partial_sudoku.PartialSudoku;
import solver_state.SolverState;
import strategies.*;
import strategies.singles.*;
import strategies.x_wing.*;

# Easiest first.
fun all_strategies() -> List[Strategy] = {
	var s: List[Strategy];
	s.push(Strategy("Full House", 1.0, find_full_house));
	s.push(Strategy("Hidden Single", 1.2, find_hidden_single));
	s.push(Strategy("Naked Single", 2.3, find_naked_single));
	s.push(Strategy("X-Wing", 3.5, find_x_wing));
	return s;
}

# The steps of all moves, in order. A move is one application of a strategy.
class SolveResult {
	steps: List[Step];
	snapshots: List[SolverState];  # the state each step is shown on, i.e. before its move
	move_start: List[i64];         # index of the first step of each move
	stuck: bool;                   # no strategy applies to the final state
}

class SudokuSolver {
	state: SolverState;

	global fun create(puzzle: ref PartialSudoku) = SudokuSolver(SolverState.create(puzzle));

	# After every move, starts over from the easiest strategy, so each move is as simple as possible.
	fun solve() -> SolveResult = {
		let strategies = all_strategies();
		var r: SolveResult;
		while (not state.solved()) {
			var i = 0;
			while (i < strategies.length() and not try_strategy(strategies.at(i), &r)) { i += 1; }
			if (i == strategies.length()) {
				r.stuck = true;
				break;
			}
		}
		return r;
	}

	fun try_strategy(strategy: ref Strategy, r: ref SolveResult) -> bool = {
		var sb: StepsBuilder;
		if (not strategy.find(&state, &sb)) { return false; }

		r.move_start.push(r.steps.length());
		var k = 0;
		while (k < sb.steps.length()) {
			var step = copy sb.steps.at(k);
			step.strategy = strategy.name;
			step.difficulty = strategy.difficulty;
			r.snapshots.push(state);
			r.steps.push(move step);
			k += 1;
		}
		apply(sb.cur());
		return true;
	}

	fun apply(step: ref Step) = {
		var k = 0;
		while (k < step.placements.length()) {
			let p = step.placements.at(k);
			state.place(p.cell, p.digit);
			k += 1;
		}
		k = 0;
		while (k < step.eliminations.length()) {
			let e = step.eliminations.at(k);
			state.eliminate(e.cell, e.digit);
			k += 1;
		}
	}
}
